# Anthropic API key: get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Twilio credentials: get from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx

# Port (Railway sets this automatically)
PORT=3000

# Optional: SQLite file location. On Railway, attach a volume (e.g. mounted at /data)
# and set DB_PATH=/data/french_bot.db so vocab/history survive redeploys.
# DB_PATH=/data/french_bot.db

# Optional: comma-separated allowlist of phone numbers (include YOUR OWN number!).
# If unset, anyone who joins the sandbox can use the bot.
# ALLOWED_NUMBERS=+15555550100,+15555550101
